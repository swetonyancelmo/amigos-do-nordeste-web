# Copie para .env.local. NUNCA comite.

# Onde está a API. Quem lê é o servidor do Next, não o navegador: o painel
# chama /api/... na própria origem e o Next repassa para cá (next.config.mjs).
# Por isso "localhost" funciona até abrindo o painel pelo celular na rede local
# (http://IP-DA-MAQUINA:3000), desde que a API rode na mesma máquina do Next.
# Em produção, a URL do serviço do repositório cadastro-familias-api; é lida no
# build, então trocou, gere de novo.
API_URL=http://localhost:3333
